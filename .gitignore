.pio
# CLion / CMake build folders (must never live inside src/ – they would be
# picked up by ESP-IDF component globs and break the build).
cmake-build-*/
**/cmake-build-*/

# ESP-IDF ignore
build/
sdkconfig.old
managed_components/
dependencies.lock

# Editors
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.pyc
